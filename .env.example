# Optional. Copy to .env next to compose.yaml.

# Host port the app is published on.
HDIET_PORT=8080

# "open" lets anyone who can reach the server create an account.
# Set to "closed" once your own account exists.
HDIET_REGISTRATION=open

# Public address of this installation, e.g. https://hackdiet.example.org.
# Used for the badge embed code, e-mails and XML exports. If empty, it is
# taken from the request (Host and X-Forwarded-Proto headers).
HDIET_BASE_URL=

# Secrets. Leave empty to have random values generated on first start and
# stored in the data volume (.secrets/). Set them only if you want to manage
# them yourself, e.g. with: openssl rand -hex 32
# Changing HDIET_BADGE_KEY breaks badge URLs that were already embedded;
# changing HDIET_SALT signs out "remember me" sessions.
HDIET_BADGE_KEY=
HDIET_SALT=
